<?xml version="1.0"?>
<!--
  Hardware-only smoke test: Kinova Gen3 driver, no Geomagic / teleop.
  Default robot controller: 192.168.1.10 (override with robot_ip:=...)
-->
<launch>
  <arg name="robot_ip" default="192.168.1.10"/>
  <arg name="vision" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_moveit" default="false"/>

  <include file="$(find kortex_driver)/launch/kortex_driver.launch">
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="start_moveit" value="$(arg start_moveit)"/>
    <arg name="ip_address" value="$(arg robot_ip)"/>
    <arg name="vision" value="$(arg vision)"/>
  </include>
</launch>
