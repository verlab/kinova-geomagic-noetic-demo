<?xml version="1.0"?>
<launch>
  <arg name="reference_frame" default="/map"/>
  <arg name="units" default="mm"/>
  <arg name="publish_rate" default="100"/>
  <arg name="omni_name" default="geomagic"/>
  <arg name="force_topic" default="/arm/arm_ft_feedback_rot"/>
  
  <node name="geomagic_node" pkg="geomagic_control" type="omni_cartesian" output="screen"> 
    <param name="omni_name" value="$(arg omni_name)"/>
    <param name="publish_rate" value="$(arg publish_rate)"/>
    <param name="reference_frame" value="$(arg reference_frame)"/>
    <param name="units" value="$(arg units)"/>
    <param name="force_topic" value="$(arg force_topic)"/>
  </node>
</launch>