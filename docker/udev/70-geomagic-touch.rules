# Install on the Linux host (not only inside Docker): copy to /etc/udev/rules.d/ then:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Geomagic Touch (USB) — common IDs (Touch / Phantom Omni family). Add your lsusb line if different.
SUBSYSTEM=="usb", ATTR{idVendor}=="256f", ATTR{idProduct}=="c652", MODE="0660", GROUP="plugdev"
KERNEL=="hidraw*", ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c652", MODE="0660", GROUP="plugdev"
# Alternate product id seen on some units:
SUBSYSTEM=="usb", ATTR{idVendor}=="256f", ATTR{idProduct}=="c631", MODE="0660", GROUP="plugdev"
